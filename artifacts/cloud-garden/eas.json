{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.13.0",
      "corepack": true
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ADMOB_TEST_ADS": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
